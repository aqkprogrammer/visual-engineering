{
  "name": "visual-engineering",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Interactive, visual lessons on system design, AI engineering, infrastructure, networking and computer science.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content": "tsx scripts/content.ts",
    "readme": "tsx scripts/readme.ts",
    "budget": "tsx scripts/budget.ts",
    "links": "tsx scripts/links.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "dev": "pnpm content && next dev",
    "build": "pnpm content && next build",
    "preview": "serve out --listen 3000",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm content && next typegen && tsc --noEmit",
    "test": "pnpm content && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm readme --check && pnpm build && pnpm budget && pnpm links"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.2",
    "@shikijs/rehype": "4.5.0",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-slug": "6.0.0",
    "server-only": "0.0.1",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "chrome-launcher": "1.2.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "github-slugger": "2.0.0",
    "jsdom": "30.1.3",
    "lighthouse": "13.5.0",
    "mdast-util-to-string": "4.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vitest": "5.0.5"
  }
}
